# Cloudflare Pages 响应头配置
# 文档: https://developers.cloudflare.com/pages/configuration/headers/
#
# 重要：多条规则命中同一路径时，响应头会「叠加」。
# 因此 Cache-Control 必须保证每个路径只命中一条规则，否则会出现
# 重复的 max-age（如 "max-age=300, max-age=86400"），浏览器行为不一致。
# 本文件的做法：/* 只放安全头，Cache-Control 由下方互不重叠的具体规则提供。

# ── 全局：仅安全头（刻意不放 Cache-Control，避免与下方规则叠加）──
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# ── 首页（目录根路径，不会被 /*.html 命中）─────────────────────
/
  Cache-Control: public, max-age=300, must-revalidate

# ── 游戏页面：一天缓存 ───────────────────────────────────────
/games/*
  Cache-Control: public, max-age=86400

# ── 样式 / 脚本：长期缓存 ────────────────────────────────────
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# ── 图片资源（含社交封面 og-cover.svg）：一周缓存 ──────────────
/assets/*.svg
  Cache-Control: public, max-age=604800
